---
import "../styles/global.css";
// The rendered page and the repo's CHANGELOG.md are the same file — editing
// the markdown is the only step to publish a change log entry.
import { Content } from "../../CHANGELOG.md";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>Change Log — Films with Friends</title>
  </head>
  <body>
    <main class="content">
      <article class="changelog">
        <Content />
      </article>
      <footer class="page-footer">
        <a href={import.meta.env.BASE_URL}>Back to showtimes</a>
      </footer>
    </main>
  </body>
</html>

<style>
  .content {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1rem;
  }

  .changelog :global(h1) {
    margin-bottom: 0.25rem;
  }

  /* Each dated release is a section break; the headings below it are the
     individual changes. */
  .changelog :global(h2) {
    margin-top: 2.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(0, 0, 0, 0.2);
    font-size: var(--font-size-xl);
  }

  .changelog :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.25rem;
    font-size: var(--font-size-lg);
  }

  .changelog :global(p) {
    margin: 0.5rem 0;
    line-height: 1.5;
  }

  .page-footer {
    margin: 2.5rem 0 1rem;
    font-size: var(--font-size-sm);
    text-align: center;
  }
</style>
