---
import { join } from "node:path";
import EventList from "../components/EventList.astro";
import Nav from "../components/Nav.astro";
import { loadAllEvents } from "../lib/events/loadEvents";
import { localDayOf } from "../lib/events/query";

const DATA_DIR = join(process.cwd(), "movie-data");

const now = new Date();
const today = localDayOf(now);

const allEvents = await loadAllEvents(DATA_DIR);
const upcoming = allEvents.filter((event) => event.startTime >= now.toISOString());
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>SF Movies — Browse by day</title>
	</head>
	<body>
		<h1>Browse by day</h1>
		<Nav />
		<p>
			<input type="date" id="day-picker" value={today} />
		</p>
		<p id="no-matches" hidden>Nothing playing that day.</p>
		<div id="results">
			<EventList events={upcoming} emptyMessage="No upcoming showtimes yet." />
		</div>

		<script>
			const input = document.getElementById("day-picker") as HTMLInputElement;
			const items = document.querySelectorAll<HTMLLIElement>("#results li[data-date]");
			const noMatches = document.getElementById("no-matches") as HTMLElement;

			function applyFilter() {
				const date = input.value;
				let visibleCount = 0;

				for (const item of items) {
					const matches = item.dataset.date === date;
					item.hidden = !matches;
					if (matches) visibleCount += 1;
				}

				noMatches.hidden = visibleCount > 0;
			}

			input.addEventListener("change", applyFilter);
			applyFilter();
		</script>
	</body>
</html>
