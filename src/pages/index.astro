---
import "../styles/global.css";
import { join } from "node:path";
import FilterBar from "../components/FilterBar.astro";
import MovieCard from "../components/MovieCard.astro";
import StarIcon from "../components/StarIcon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { preferredDateFmt } from "../shared/dateFormat";
import { loadAllEvents } from "../shared/events/loadEvents";
import { findUpcoming, groupByDay } from "../shared/events/schedule";

const DATA_DIR = join(process.cwd(), "movie-data");

const allEvents = await loadAllEvents(DATA_DIR);
const upcoming = findUpcoming(allEvents, new Date());
const dayGroups = groupByDay(upcoming);

// dayGroup.date is already the correct America/Los_Angeles calendar day as
// "YYYY-MM-DD" — format it at UTC noon so no timezone reinterpretation can
// shift it to the wrong day.
const dayHeaderFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "UTC",
  weekday: "short",
  day: "2-digit",
  month: "short",
  year: "numeric",
});

function formatDayHeader(date: string): string {
  return preferredDateFmt(dayHeaderFormatter, new Date(`${date}T12:00:00Z`));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>Picture Show with Friends</title>
  </head>
  <body>
    <main class="content">
      <h1>A Picture Show with Friends</h1>
      <div class="mobile-tabs">
        <button type="button" class="mobile-tab" data-mode="wishlist" aria-pressed="true">
          <StarIcon class="mobile-tab__star" /> Wish List
        </button>
        <button type="button" class="mobile-tab" data-mode="browse" aria-pressed="false">
          Browsing
        </button>
      </div>
      <div class="panes">
        <div class="panes-track">
          <!-- Named explicitly rather than by the heading: the heading is
               display:none on mobile, and a hidden label is read with the
               decorative star included. -->
          <section class="pane wishlist-pane" aria-label="Wish List">
            <h2 class="pane-heading"><StarIcon /> Wish List</h2>
            <!-- Who has this list open. Only shown on a list's own URL. -->
            <p id="presence" class="presence" hidden>
              <span id="presence-you"></span>
              <span id="presence-others"></span>
            </p>
            <div id="wishlist-empty" class="wishlist-empty">
              <p>The indie theaters of San Francisco each list their own showtimes. We gather them here.</p>
              <p>Look through the Browsing list. When you find a showing you
              want, click the ★. It goes to your Wish List. Send the list to
              your friends and go. Together.</p>
              <img
                class="wishlist-empty__image"
                src={`${import.meta.env.BASE_URL}film-projector.png`}
                alt="Vintage film projector illustration"
              />
              <p>Take <a href="https://github.com/nitidbit/sf-movies">the code</a> and make one for your own town.</p>
              <p>Write to <strong>winston at nitidbit dot com</strong>. Bugs or kudos, both are good.</p>
              <p>The name is not settled. Films with Friends. A Picture Show
              with Friends. Flicks with Friends. Películas con Amigos. Tell me
              which is right, or send a better one.</p>
            </div>
            {
              dayGroups.map((group) => (
                <section class="day-group" hidden>
                  <h3>{formatDayHeader(group.date)}</h3>
                  <ul class="day-group__cards">
                    {group.events.map((event) => (
                      <MovieCard event={event} hidden inWishlist />
                    ))}
                  </ul>
                </section>
              ))
            }
            <!-- Starred showings the built page no longer has, because their
                 day has passed. The page script fills it from the server's
                 copy. -->
            <section id="wishlist-past" class="day-group" hidden>
              <h3>Past</h3>
              <ul id="wishlist-past-cards" class="day-group__cards"></ul>
            </section>
            <SiteFooter />
          </section>

          <section class="pane browse-pane" aria-label="Browsing">
            <h2 class="pane-heading">Browsing</h2>
            <FilterBar />
            {
              dayGroups.length === 0 ? (
                <p>No upcoming showtimes yet.</p>
              ) : (
                dayGroups.map((group) => (
                  <section class="day-group">
                    <h3>{formatDayHeader(group.date)}</h3>
                    <ul class="day-group__cards">
                      {group.events.map((event) => (
                        <MovieCard event={event} />
                      ))}
                    </ul>
                  </section>
                ))
              )
            }
          </section>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .mobile-tabs {
    display: none;
  }

  .panes {
    /* On mobile this becomes the clipping viewport for the sliding track;
       harmless as a plain wrapper at desktop widths. */
    overflow: hidden;
  }

  .panes-track {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .pane {
    flex: 1 1 50%;
    min-width: 0;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }

  /* Names the list each pane holds. On mobile the tab bar already does this,
     so these are hidden below the breakpoint. The rule underneath echoes the
     one under the tabs, but it is only decoration here — nothing to tap. */
  .pane-heading {
    margin-top: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #888;
  }

  .presence {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.5rem 0 0;
    font-size: var(--font-size-sm);
  }

  .presence[hidden] {
    display: none;
  }

  .wishlist-empty {
    padding-top: 1rem;
    opacity: 0.7;
    line-height: 1.5;
  }

  .wishlist-empty p + p {
    margin-top: 0.75rem;
  }

  .wishlist-empty__image {
    display: block;
    width: calc(100% - 2rem);
    margin: 2rem 1rem 0;
  }

  .day-group__cards {
    padding: 0;
    margin: 0;
  }

  /* Desktop is a fixed frame: the page itself never scrolls and each pane
     scrolls its own list. Every height here is what is left over after the
     h1 and the footer have taken theirs, so neither has to be measured by
     hand — the .pane max-height above is the mobile fallback only. */
  @media (min-width: 769px) {
    :global(body) {
      margin: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .content,
    .panes {
      flex: 1;
      /* Without this a flex child refuses to shrink below its content, and
         the overflow reappears one level up. */
      min-height: 0;
    }

    .content {
      display: flex;
      flex-direction: column;
      /* As a flex item the auto side margins suppress the usual stretch, so
         it has to be told to fill the window before max-width caps it. */
      width: 100%;
      box-sizing: border-box;
    }

    .panes-track {
      height: 100%;
      align-items: stretch;
    }

    .pane {
      max-height: none;
    }
  }

  /* Below this width, the two panes become full-width "modes" switched by
     the sticky tab bar — a JS-driven slide to a definite end state, not a
     native scroll gesture, so it can't ever land half-transitioned. */
  @media (max-width: 768px) {
    .mobile-tabs {
      display: flex;
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--body-background);
      border-bottom: 1px solid #888;
    }

    .mobile-tab {
      flex: 1 1 50%;
      padding: 0.75rem;
      border: none;
      background: none;
      font: inherit;
      cursor: pointer;
      opacity: 0.6;
      touch-action: manipulation;
    }

    .mobile-tab__star {
      color: #e0a800;
    }

    .mobile-tab[aria-pressed="true"] {
      opacity: 1;
      font-weight: bold;
      border-bottom: 3px solid #333;
    }

    .panes-track {
      width: 200%;
      gap: 0;
      transition: transform 150ms ease-out;
    }

    .panes-track.mode-browse {
      transform: translateX(-50%);
    }

    .pane {
      flex: 0 0 50%;
    }

    .pane-heading {
      display: none;
    }
  }
</style>

<script>
  import { formatShowtime } from "../shared/dateFormat";
  import { compareByStartTime } from "../shared/events/schedule";
  import {
    cleanHandle,
    listIdFromPath,
    loadHandle,
    newListId,
    saveHandle,
    sendChange,
    othersWatching,
    type ListMessage,
    type ListShowing,
  } from "../shared/sharedList";

  interface CardRefs {
    starButtons: HTMLButtonElement[];
    wishlistCard: HTMLLIElement | null;
  }

  const wishlistEmpty = document.getElementById("wishlist-empty") as HTMLElement;
  const pastCards = document.getElementById("wishlist-past-cards") as HTMLUListElement;
  const presence = document.getElementById("presence") as HTMLElement;
  const presenceYou = document.getElementById("presence-you") as HTMLElement;
  const presenceOthers = document.getElementById("presence-others") as HTMLElement;

  let listId = listIdFromPath(location.pathname);
  let handle = loadHandle();
  let showings: ListShowing[] = [];
  let watching: string[] = [];
  let events: EventSource | null = null;
  let connection: "connecting" | "open" | "lost" = "connecting";
  // Showings the visitor just starred, so only their own star animates.
  const justStarred = new Set<string>();

  // One pass over every card (both panes) builds a sourceUrl -> refs map,
  // so each render is a lookup instead of re-querying the DOM.
  const cardsBySourceUrl = new Map<string, CardRefs>();

  for (const card of document.querySelectorAll<HTMLLIElement>(".movie-card")) {
    const sourceUrl = card.dataset.sourceUrl;
    if (!sourceUrl) continue;

    const refs = cardsBySourceUrl.get(sourceUrl) ?? { starButtons: [], wishlistCard: null };
    const button = card.querySelector<HTMLButtonElement>(".star-toggle");
    if (button) refs.starButtons.push(button);
    if (card.closest(".wishlist-pane")) refs.wishlistCard = card;

    cardsBySourceUrl.set(sourceUrl, refs);
  }

  // Past cards are copies of a Wish List card, so they keep the card's
  // scoped styles. Taken before any render, while it is still untouched.
  const cardTemplate = document.querySelector<HTMLLIElement>(".wishlist-pane .movie-card")?.cloneNode(true) as
    | HTMLLIElement
    | undefined;
  cardTemplate?.querySelector(".movie-card__synopsis")?.remove();

  function updateWishlistDayGroups() {
    for (const group of document.querySelectorAll<HTMLElement>(".wishlist-pane .day-group")) {
      const hasVisibleCard = group.querySelector(".movie-card:not([hidden])") !== null;
      group.hidden = !hasVisibleCard;
    }
    wishlistEmpty.hidden = document.querySelector(".wishlist-pane .movie-card:not([hidden])") !== null;
  }

  function renderStar(button: HTMLButtonElement, stars: string[]) {
    button.setAttribute("aria-pressed", String(handle !== null && stars.includes(handle)));
    const initials = button.querySelector(".star-toggle__initials");
    if (initials) initials.textContent = stars.join(" ");
  }

  function renderComments(card: HTMLLIElement, showing: ListShowing) {
    const list = card.querySelector(".comment-list");
    if (!list) return;

    list.replaceChildren(
      ...showing.comments.map((comment) => {
        const item = document.createElement("li");
        item.dataset.commentId = String(comment.id);

        const who = document.createElement("span");
        who.className = "comment__handle";
        who.textContent = comment.handle;
        item.append(who, comment.body);

        if (comment.handle === handle) {
          for (const action of ["Edit", "Delete"]) {
            const button = document.createElement("button");
            button.type = "button";
            button.className = `comment__action comment__${action.toLowerCase()}`;
            button.textContent = action;
            item.append(button);
          }
        }
        return item;
      }),
    );
  }

  function makePastCard(showing: ListShowing): HTMLLIElement {
    const card = cardTemplate!.cloneNode(true) as HTMLLIElement;
    card.hidden = false;
    card.dataset.sourceUrl = showing.sourceUrl;
    card.dataset.startTime = showing.startTime;
    card.dataset.theater = showing.theater;

    const link = card.querySelector(".movie-card__title a") as HTMLAnchorElement;
    link.href = showing.sourceUrl;
    link.textContent = showing.title;

    const [when, theater] = card.querySelectorAll(".movie-card__meta span");
    when.removeAttribute("title");
    when.textContent = formatShowtime(new Date(showing.startTime));
    theater.textContent = showing.theater;
    return card;
  }

  // Draws the whole list: the stars on every card in both panes, which
  // Wish List cards show, their comments, and the Past section.
  function render() {
    const bySourceUrl = new Map(showings.map((showing) => [showing.sourceUrl, showing]));

    for (const [sourceUrl, refs] of cardsBySourceUrl) {
      const showing = bySourceUrl.get(sourceUrl);
      for (const button of refs.starButtons) renderStar(button, showing?.stars ?? []);

      const card = refs.wishlistCard;
      if (!card) continue;
      card.hidden = !showing;
      if (showing) renderComments(card, showing);
      if (showing && justStarred.has(sourceUrl)) {
        card.classList.add("movie-card--revealed");
        card.addEventListener("animationend", () => card.classList.remove("movie-card--revealed"), {
          once: true,
        });
      }
    }
    justStarred.clear();

    const past = showings.filter((showing) => !cardsBySourceUrl.has(showing.sourceUrl)).sort(compareByStartTime);
    pastCards.replaceChildren(
      ...(cardTemplate ? past : []).map((showing) => {
        const card = makePastCard(showing);
        renderStar(card.querySelector(".star-toggle")!, showing.stars);
        renderComments(card, showing);
        return card;
      }),
    );

    updateWishlistDayGroups();
  }

  function renderPresence() {
    presence.hidden = !listId;
    presenceYou.textContent = `you: ${handle ?? ""}`;
    presenceOthers.textContent =
      connection === "open"
        ? `others: ${othersWatching(watching, handle).join(", ") || "none"}`
        : connection === "connecting"
          ? "connecting…"
          : "not connected to server, retrying…";
  }

  function showList(message: ListMessage) {
    showings = message.showings;
    watching = message.watching;
    render();
    renderPresence();
  }

  // The server sends the whole list and who has it open when the stream
  // opens, after every change, and when anyone opens or closes the list.
  // EventSource reconnects by itself if it drops. The handle goes along so
  // the server can tell the others who is here.
  function watchList(id: string) {
    events?.close();
    events = new EventSource(`/api/lists/${id}/events?handle=${encodeURIComponent(handle ?? "")}`);
    events.onopen = () => {
      connection = "open";
      renderPresence();
    };
    events.onerror = () => {
      connection = "lost";
      renderPresence();
    };
    events.onmessage = (message) => showList(JSON.parse(message.data));
  }

  async function askForHandle(): Promise<string | null> {
    if (handle) return handle;
    const typed = window.prompt("Your handle, up to 5 characters");
    if (!typed) return null;
    const cleaned = await cleanHandle(typed);
    if (!cleaned) return null;
    handle = cleaned;
    saveHandle(handle);
    // Reconnect so the server knows who this is.
    if (listId) watchList(listId);
    renderPresence();
    return handle;
  }

  async function toggleStar(card: HTMLElement) {
    const me = await askForHandle();
    if (!me) return;

    if (!listId) {
      listId = newListId();
      history.pushState(null, "", `/list/${listId}`);
      watchList(listId);
    }

    const sourceUrl = card.dataset.sourceUrl!;
    const starred = showings.find((showing) => showing.sourceUrl === sourceUrl)?.stars.includes(me) ?? false;
    if (!starred) justStarred.add(sourceUrl);

    showList(
      await sendChange(listId, starred ? "DELETE" : "POST", "/stars", {
        sourceUrl,
        handle: me,
        title: card.querySelector(".movie-card__title a")?.textContent?.trim(),
        startTime: card.dataset.startTime,
        theater: card.dataset.theater,
      }),
    );
  }

  // Clicks are handled for the whole document, because Past cards and
  // comments are created after the page loads.
  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest<HTMLLIElement>(".movie-card");
    if (!card) return;

    if (target.closest(".star-toggle")) {
      await toggleStar(card);
      return;
    }

    const commentId = target.closest<HTMLElement>("[data-comment-id]")?.dataset.commentId;
    if (!listId || !handle || !commentId) return;

    if (target.closest(".comment__edit")) {
      const current = showings.flatMap((showing) => showing.comments).find((c) => String(c.id) === commentId);
      const body = window.prompt("Edit comment", current?.body ?? "");
      if (body) showList(await sendChange(listId, "PUT", `/comments/${commentId}`, { handle, body }));
    } else if (target.closest(".comment__delete")) {
      showList(await sendChange(listId, "DELETE", `/comments/${commentId}`, { handle }));
    }
  });

  document.addEventListener("submit", async (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>(".comment-form");
    if (!form) return;
    event.preventDefault();

    const input = form.querySelector<HTMLInputElement>(".comment-form__input")!;
    const body = input.value.trim();
    const me = await askForHandle();
    if (!body || !me || !listId) return;

    const sourceUrl = form.closest<HTMLElement>(".movie-card")!.dataset.sourceUrl;
    input.value = "";
    showList(await sendChange(listId, "POST", "/comments", { sourceUrl, handle: me, body }));
  });

  if (listId) watchList(listId);
  render();
  renderPresence();

  for (const synopsis of document.querySelectorAll<HTMLButtonElement>(".movie-card__synopsis")) {
    synopsis.addEventListener("click", () => {
      synopsis.setAttribute("aria-expanded", String(synopsis.getAttribute("aria-expanded") !== "true"));
    });
  }

  // Mobile-only mode switch: tapping a tab slides the track to a definite
  // end position (0% or -50%) via CSS transition, rather than relying on
  // touch-scroll physics to land on the right spot.
  const panesTrack = document.querySelector<HTMLElement>(".panes-track");
  const mobileTabs = document.querySelectorAll<HTMLButtonElement>(".mobile-tab");

  for (const tab of mobileTabs) {
    tab.addEventListener("click", () => {
      const mode = tab.dataset.mode;
      panesTrack?.classList.toggle("mode-browse", mode === "browse");
      for (const otherTab of mobileTabs) {
        otherTab.setAttribute("aria-pressed", String(otherTab === tab));
      }
    });
  }
</script>
