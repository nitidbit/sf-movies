---
import "../styles/global.css";
import { join } from "node:path";
import FilterBar from "../components/FilterBar.astro";
import MovieCard from "../components/MovieCard.astro";
import StarIcon from "../components/StarIcon.astro";
import { preferredDateFmt } from "../shared/dateFormat";
import { loadAllEvents } from "../shared/events/loadEvents";
import { findUpcoming, groupByDay } from "../shared/events/schedule";

const DATA_DIR = join(process.cwd(), "movie-data");

const allEvents = await loadAllEvents(DATA_DIR);
const upcoming = findUpcoming(allEvents, new Date());
const dayGroups = groupByDay(upcoming);

// dayGroup.date is already the correct America/Los_Angeles calendar day as
// "YYYY-MM-DD" — format it at UTC noon so no timezone reinterpretation can
// shift it to the wrong day.
const dayHeaderFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "UTC",
  weekday: "short",
  day: "2-digit",
  month: "short",
  year: "numeric",
});

function formatDayHeader(date: string): string {
  return preferredDateFmt(dayHeaderFormatter, new Date(`${date}T12:00:00Z`));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>Films with Friends</title>
  </head>
  <body>
    <main class="content">
      <h1>Films with Friends</h1>
      <div class="mobile-tabs">
        <button type="button" class="mobile-tab" data-mode="wishlist" aria-pressed="true">
          <StarIcon class="mobile-tab__star" /> Wish List
        </button>
        <button type="button" class="mobile-tab" data-mode="browse" aria-pressed="false">
          Browsing
        </button>
      </div>
      <div class="panes">
        <div class="panes-track">
          <section class="pane wishlist-pane">
            <div id="wishlist-empty" class="wishlist-empty">
              <p>Films with Friends collects showtimes from San Francisco Bay Area indie theaters, all in one place.</p>
              <p>The Browsing list shows local movie showings. Click the ★ on
              any showing to start your wish list — starred showings will show
              up in your Wish List. Then send your list to friends to arrange a movie night out, IRL!</p>
              <img
                class="wishlist-empty__image"
                src={`${import.meta.env.BASE_URL}film-projector.png`}
                alt="Vintage film projector illustration"
              />
              <p>Make a version of this website for your town by <a href="https://github.com/nitidbit/sf-movies">forking the git repo</a>.</p>
              <p>Send bug reports or kudos to <strong> winston at nitidbit dot com </strong></p>
            </div>
            {
              dayGroups.map((group) => (
                <section class="day-group" hidden>
                  <h2>{formatDayHeader(group.date)}</h2>
                  <ul class="day-group__cards">
                    {group.events.map((event) => (
                      <MovieCard event={event} hidden />
                    ))}
                  </ul>
                </section>
              ))
            }
          </section>

          <section class="pane browse-pane">
            <FilterBar />
            {
              dayGroups.length === 0 ? (
                <p>No upcoming showtimes yet.</p>
              ) : (
                dayGroups.map((group) => (
                  <section class="day-group">
                    <h2>{formatDayHeader(group.date)}</h2>
                    <ul class="day-group__cards">
                      {group.events.map((event) => (
                        <MovieCard event={event} />
                      ))}
                    </ul>
                  </section>
                ))
              )
            }
          </section>
        </div>
      </div>
      <footer class="site-footer">
        <a href={`${import.meta.env.BASE_URL}change_log`}>Change log</a>
        <span aria-hidden="true"> · </span>
        <a href={`${import.meta.env.BASE_URL}status`}>Scraper status</a>
      </footer>
    </main>
  </body>
</html>

<style>
  .content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .site-footer {
    margin: 2rem 0 1rem;
    font-size: var(--font-size-sm);
    text-align: center;
  }

  .mobile-tabs {
    display: none;
  }

  .panes {
    /* On mobile this becomes the clipping viewport for the sliding track;
       harmless as a plain wrapper at desktop widths. */
    overflow: hidden;
  }

  .panes-track {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .pane {
    flex: 1 1 50%;
    min-width: 0;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }

  .wishlist-pane__heading {
    margin-top: 0;
  }

  .wishlist-empty {
    padding-top: 1rem;
    opacity: 0.7;
    line-height: 1.5;
  }

  .wishlist-empty p + p {
    margin-top: 0.75rem;
  }

  .wishlist-empty__image {
    display: block;
    width: calc(100% - 2rem);
    margin: 2rem 1rem 0;
  }

  .day-group__cards {
    padding: 0;
    margin: 0;
  }

  /* Below this width, the two panes become full-width "modes" switched by
     the sticky tab bar — a JS-driven slide to a definite end state, not a
     native scroll gesture, so it can't ever land half-transitioned. */
  @media (max-width: 768px) {
    .mobile-tabs {
      display: flex;
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--body-background);
      border-bottom: 1px solid #ccc;
    }

    .mobile-tab {
      flex: 1 1 50%;
      padding: 0.75rem;
      border: none;
      background: none;
      font: inherit;
      cursor: pointer;
      opacity: 0.6;
      touch-action: manipulation;
    }

    .mobile-tab__star {
      color: #e0a800;
    }

    .mobile-tab[aria-pressed="true"] {
      opacity: 1;
      font-weight: bold;
      border-bottom: 2px solid #333;
    }

    .panes-track {
      width: 200%;
      gap: 0;
      transition: transform 150ms ease-out;
    }

    .panes-track.mode-browse {
      transform: translateX(-50%);
    }

    .pane {
      flex: 0 0 50%;
    }
  }
</style>

<script>
  import { loadWishlist, saveWishlist } from "../shared/wishlist";

  interface CardRefs {
    starButtons: HTMLButtonElement[];
    wishlistCard: HTMLLIElement | null;
  }

  const wishlistEmpty = document.getElementById("wishlist-empty") as HTMLElement;
  const wishlistedIds = new Set(loadWishlist());

  // One pass over every card (both panes) builds a sourceUrl -> refs map,
  // so toggling a star is an O(1) lookup instead of re-querying the DOM
  // on every click.
  const cardsBySourceUrl = new Map<string, CardRefs>();

  for (const card of document.querySelectorAll<HTMLLIElement>(".movie-card")) {
    const sourceUrl = card.dataset.sourceUrl;
    if (!sourceUrl) continue;

    const refs = cardsBySourceUrl.get(sourceUrl) ?? { starButtons: [], wishlistCard: null };
    const button = card.querySelector<HTMLButtonElement>(".star-toggle");
    if (button) refs.starButtons.push(button);
    if (card.closest(".wishlist-pane")) refs.wishlistCard = card;

    cardsBySourceUrl.set(sourceUrl, refs);
  }

  function updateWishlistDayGroups() {
    for (const group of document.querySelectorAll<HTMLElement>(".wishlist-pane .day-group")) {
      const hasVisibleCard = group.querySelector(".movie-card:not([hidden])") !== null;
      group.hidden = !hasVisibleCard;
    }
    // Based on what's actually rendered, not wishlistedIds.size — a saved
    // id whose event has since aged off the list would otherwise leave the
    // pane blank (empty state hidden, but no card to show either).
    wishlistEmpty.hidden = document.querySelector(".wishlist-pane .movie-card:not([hidden])") !== null;
  }

  // The single source of truth for a showing's starred state: updates both
  // star buttons (browse + wishlist twin), the wishlist twin's
  // visibility, and persistence. `animate` is false when restoring saved
  // state on load — only a user's own click should trigger the reveal
  // transition.
  function setStarred(sourceUrl: string, starred: boolean, animate: boolean) {
    const refs = cardsBySourceUrl.get(sourceUrl);
    if (!refs) return;

    for (const button of refs.starButtons) {
      button.setAttribute("aria-pressed", String(starred));
    }

    if (refs.wishlistCard) {
      refs.wishlistCard.hidden = !starred;
      if (starred && animate) {
        refs.wishlistCard.classList.add("movie-card--revealed");
        refs.wishlistCard.addEventListener(
          "animationend",
          () => refs.wishlistCard?.classList.remove("movie-card--revealed"),
          { once: true },
        );
      }
    }

    updateWishlistDayGroups();
  }

  for (const sourceUrl of wishlistedIds) {
    setStarred(sourceUrl, true, false);
  }
  updateWishlistDayGroups();

  for (const [sourceUrl, refs] of cardsBySourceUrl) {
    for (const button of refs.starButtons) {
      button.addEventListener("click", () => {
        const starred = !wishlistedIds.has(sourceUrl);
        if (starred) {
          wishlistedIds.add(sourceUrl);
        } else {
          wishlistedIds.delete(sourceUrl);
        }
        setStarred(sourceUrl, starred, true);
        saveWishlist(Array.from(wishlistedIds));
      });
    }
  }

  for (const synopsis of document.querySelectorAll<HTMLButtonElement>(".movie-card__synopsis")) {
    synopsis.addEventListener("click", () => {
      synopsis.setAttribute("aria-expanded", String(synopsis.getAttribute("aria-expanded") !== "true"));
    });
  }

  // Mobile-only mode switch: tapping a tab slides the track to a definite
  // end position (0% or -50%) via CSS transition, rather than relying on
  // touch-scroll physics to land on the right spot.
  const panesTrack = document.querySelector<HTMLElement>(".panes-track");
  const mobileTabs = document.querySelectorAll<HTMLButtonElement>(".mobile-tab");

  for (const tab of mobileTabs) {
    tab.addEventListener("click", () => {
      const mode = tab.dataset.mode;
      panesTrack?.classList.toggle("mode-browse", mode === "browse");
      for (const otherTab of mobileTabs) {
        otherTab.setAttribute("aria-pressed", String(otherTab === tab));
      }
    });
  }
</script>
