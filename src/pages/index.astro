---
import { join } from "node:path";
import EventList from "../components/EventList.astro";
import Nav from "../components/Nav.astro";
import { loadAllEvents } from "../lib/events/loadEvents";

const DATA_DIR = join(process.cwd(), "movie-data");

const now = new Date().toISOString();
const allEvents = await loadAllEvents(DATA_DIR);
const upcoming = allEvents.filter((event) => event.startTime >= now);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>SF Movies</title>
	</head>
	<body>
		<h1>SF Movies</h1>
		<Nav />
		<EventList events={upcoming} emptyMessage="No upcoming showtimes yet." />
	</body>
</html>
