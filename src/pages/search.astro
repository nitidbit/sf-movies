---
import { join } from "node:path";
import EventList from "../components/EventList.astro";
import Nav from "../components/Nav.astro";
import { loadAllEvents } from "../lib/events/loadEvents";

const DATA_DIR = join(process.cwd(), "movie-data");

const now = new Date().toISOString();
const allEvents = await loadAllEvents(DATA_DIR);
const upcoming = allEvents.filter((event) => event.startTime >= now);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>SF Movies — Search</title>
	</head>
	<body>
		<h1>Search by title</h1>
		<Nav />
		<p>
			<input type="search" id="title-query" placeholder="Movie title…" autofocus />
		</p>
		<p id="no-matches" hidden>No matching showtimes.</p>
		<div id="results">
			<EventList events={upcoming} emptyMessage="No upcoming showtimes yet." />
		</div>

		<script>
			const input = document.getElementById("title-query") as HTMLInputElement;
			const items = document.querySelectorAll<HTMLLIElement>("#results li[data-title]");
			const noMatches = document.getElementById("no-matches") as HTMLElement;

			function applyFilter() {
				const needle = input.value.trim().toLowerCase();
				let visibleCount = 0;

				for (const item of items) {
					const matches = needle === "" || (item.dataset.title ?? "").includes(needle);
					item.hidden = !matches;
					if (matches) visibleCount += 1;
				}

				noMatches.hidden = visibleCount > 0;
			}

			input.addEventListener("input", applyFilter);
		</script>
	</body>
</html>
