---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["star-icon", className]}>★</div>

<style>
  .star-icon {
    font-family: "Lato", sans-serif;
    /* Calibrated so the glyph's rendered ink height (not the font-size
       itself, which is always taller than a glyph's visible bounds) is
       ~20px at the default root font-size. */
    font-size: 1.7rem;
    display: inline-block;
    width: 20px;
    height: 20px;
    line-height: 15px;
  }
</style>
