---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["star-icon", className]}>★</span>

<style>
  .star-icon {
    /* Hardcoded, not inherited: form elements like <button> don't inherit
       font-family from the page by default, so this must stay self-
       contained regardless of what wraps it. */
    font-family: "Lato", sans-serif;
    font-size: 2rem;
    line-height: 1;
  }
</style>
