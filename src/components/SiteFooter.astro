---
// The site is three pages and each one links to the other two. The footer
// works out which page it is standing on, so a caller only ever writes
// <SiteFooter /> and never has to say where it is.
const base = import.meta.env.BASE_URL;

const pages = [
  { href: base, label: "Showtimes" },
  { href: `${base}change_log`, label: "Change log" },
  { href: `${base}status`, label: "Scraper status" },
];

// Astro serves these as directories, so the current path may or may not carry
// a trailing slash depending on how the visitor arrived.
const trimSlash = (path: string) => path.replace(/\/+$/, "") || "/";
const here = trimSlash(Astro.url.pathname);
const elsewhere = pages.filter((page) => trimSlash(page.href) !== here);
---

<footer class="site-footer">
  {
    elsewhere.map((page, index) => (
      <Fragment>
        {index > 0 && <span aria-hidden="true"> · </span>}
        <a href={page.href}>{page.label}</a>
      </Fragment>
    ))
  }
</footer>

<style>
  .site-footer {
    margin: 2rem 0 1rem;
    font-size: var(--font-size-sm);
    text-align: center;
  }
</style>
