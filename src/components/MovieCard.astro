---
import { preferredDateTimeFmt } from "../shared/dateFormat";
import type { Event } from "../shared/events/event";
import { localDayOf } from "../shared/events/query";

interface Props {
  event: Event;
}

const { event } = Astro.props;

const dateTimeFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Los_Angeles",
  weekday: "short",
  day: "2-digit",
  month: "short",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
});
---

<li
  class="movie-card"
  data-title={event.title.toLowerCase()}
  data-date={localDayOf(new Date(event.startTime))}
>
  <a class="movie-card__title" href={event.sourceUrl} target="_blank" rel="noopener">
    {event.title}
  </a>
  { event.notes &&
    <p class="movie-card__notes">{event.notes}</p>
  }
  <div class="movie-card__meta">
    <span>
      {preferredDateTimeFmt(dateTimeFormatter, new Date(event.startTime))}
    </span>
    <span>
      { event.attribution &&
        <small class="movie-card__attribution">({event.attribution})</small>
      }
    </span>
    <span class="movie-card__theater">{event.theater}</span>
  </div>
</li>

<style>
  .movie-card {
    list-style: none;
    background: white;
    border-radius: 0.35rem;
    padding: 0.3rem 1rem;
    line-height: 1.6rem;
    margin-bottom: 2px;
  }

  .movie-card__title {
    font-weight: bold;
  }

  .movie-card__meta {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-sm);
  }

  .movie-card__notes {
    margin: 0.25rem 0 0;
    font-size: var(--font-size-sm);
  }

  .movie-card__attribution {
    opacity: 0.75;
    font-size: var(--font-size-sm);
  }
</style>
