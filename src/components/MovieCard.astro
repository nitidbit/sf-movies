---
import StarIcon from "./StarIcon.astro";
import { preferredDateTimeFmt } from "../shared/dateFormat";
import type { Event } from "../shared/events/event";
import { localDayOf } from "../shared/filter";

interface Props {
  event: Event;
  hidden?: boolean;
}

const { event, hidden = false } = Astro.props;

const dateTimeFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Los_Angeles",
  weekday: "short",
  day: "2-digit",
  month: "short",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
});
---

<li
  class="movie-card"
  data-title={event.title.toLowerCase()}
  data-date={localDayOf(new Date(event.startTime))}
  data-theater={event.theater}
  data-source-url={event.sourceUrl}
  hidden={hidden}
>
  <div class="movie-card__header">
    <div class="movie-card__title">
      <a href={event.sourceUrl} target="_blank" rel="noopener">
        {event.title}
      </a>
    </div>
    <button class="star-toggle" type="button" aria-label="Add to wish list" aria-pressed="false">
      <StarIcon />
    </button>
  </div>
  { event.notes &&
    <p class="movie-card__notes" title={event.notes}>{event.notes}</p>
  }
  <div class="movie-card__meta">
    <span title={event.attribution}>
      {preferredDateTimeFmt(dateTimeFormatter, new Date(event.startTime))}
    </span>
    <span class="movie-card__theater">{event.theater}</span>
  </div>
</li>

<style>
  .movie-card {
    list-style: none;
    background: white;
    border-radius: 0.35rem;
    padding: 0.6rem 1rem;
    line-height: 1.2rem;
    margin-bottom: 2px;
  }

  .movie-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .movie-card__title {
    font-weight: bold;
  }

  .star-toggle {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: #999;
    /* Padding grows the tap target to ~32px; the equal, opposite margin
       cancels it back out for layout purposes, so the header row's height
       is still driven only by the icon and title text, never by this
       padding. */
    padding: 10px;
    margin: -10px;
  }

  .star-toggle[aria-pressed="true"] {
    color: #e0a800;
  }

  @keyframes wishlist-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .movie-card--revealed {
    animation: wishlist-reveal 0.3s ease-out;
  }

  .movie-card__meta {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-sm);
  }

  .movie-card__notes {
    margin: 0.25rem 0;
    font-size: var(--font-size-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
